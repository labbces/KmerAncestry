#!/bin/bash
# =============================================================================
#  KaMcEs - K-Mer Ancestry pipeline
#
#  Um driver para todos os estagios. Cada subcomando monta o manifesto e
#  submete o array; nenhum caminho e digitado aqui, tudo vem do config.sh.
#
#    ./kamces setup         # 0. instala as dependencias Python em py_pkgs
#
#  O pipeline, em tres estagios:
#    ./kamces catalogs-ms   # 1. catalogos por especie (baixa, esboca, apaga)
#    ./kamces sliding       # 2. janela deslizante -> Parquet de similaridades
#    ./kamces plots         # 3. graficos por cromossomo
#    ./kamces all           # 1-3 encadeados com -hold_jid
#
#  DOIS EIXOS, e as quatro combinacoes tem pastas separadas:
#   1) QUAIS CATALOGOS sao a referencia   (sliding, plots, pintura, hist, refs)
#        --normal   {especie}                  completos
#        --uniform  {especie}_uniformizado     profundidade = spontaneum
#        --all      os dois  (padrao)
#   2) QUAIS CROMOSSOMOS sao a consulta   (sliding, plots, pintura)
#        --genomas principal   os hibridos do GENOME_DIR  (padrao)
#        --genomas validacao   os cromossomos de officinarum e spontaneum,
#                              de identidade conhecida - a conferencia do
#                              metodo, onde a resposta ja se sabe
#        --genomas ambos       os dois
#
#  Catalogos:
#    ./kamces catalogs-ms --inventario  # so mostra o que falta, nao submete
#    ./kamces catalogs-ms --detalhe     # combinacao a combinacao, com caminhos
#    ./kamces catalogs-ms --reparar     # varre os zips, apaga o que quebrou e
#                          # refaz so o scaled mais fino que faltar
#    ./kamces catalogs-ms --so-merge --all --uniforme
#                          # --all: catalogo com todos os acessos
#                          # --uniforme: subconjunto de profundidade
#                          #   equivalente a spontaneum, sufixo _uniformizado
#
#  Graficos:
#    ./kamces sliding --genomas validacao --sample 2   # 2 cromossomos, teste
#    ./kamces plots --sample Chr01_Hap1   # so esse cromossomo
#    ./kamces plots --sample 3            # os 3 primeiros, para ver como ficou
#    ./kamces plots --metricas contencao --escalas log2
#    ./kamces pintura       # quem ganha em cada janela (--sample tambem vale)
#    ./kamces hist          # espectro de k-mers dos catalogos (formato KAT).
#                          # Vai a fila (--local roda numa sessao interativa)
#    ./kamces hist --grades validacao,uniformizado
#    ./kamces hist --sample 2             # so os 2 primeiros catalogos
#    ./kamces hist --sample officinarum,robustum
#    ./kamces hist --so-plot              # reusa o hist_kmers.tsv, so redesenha
#    HIST_YMAX=3e5 ./kamces hist --so-plot   # corta o eixo y e redesenha
#
#  Manutencao:
#    ./kamces refazer       # confere TODAS as arvores do sliding, apaga o
#                          # que quebrou e re-submete so o que falta. Roda
#                          # como job. --varrer so relata; --sem-apagar nao
#                          # apaga; --estados restringe (AUSENTE, CURTO, ...)
#    ./kamces refs          # o sliding acha as assinaturas de referencia?
#    ./kamces doctor        # que python/modulos cada estagio enxerga
#    ./kamces status        # o que ja existe e o que falta
#    ./kamces limpar        # apaga CSV perdido, so se o .parquet ja existir
#    ./kamces clean-parts   # remove partes orfas de jobs abortados
#    ./kamces bench         # rede, descompressao ou sketch: quem come o tempo?
#    ./kamces bench-ms      # mede o manysketch e extrapola para o conjunto
#    ./kamces --version     # qual build voce tem em maos
# =============================================================================
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export KAMCES_LIB="$HERE/lib"
export KAMCES_DIR="$HERE"
. "$HERE/lib/common.sh"

# MANIFEST_DIR ja vem do lib/common.sh (os .job tambem precisam dele).
mkdir -p "$MANIFEST_DIR"

c_bold=$'\033[1m'; c_dim=$'\033[2m'; c_off=$'\033[0m'
say()  { echo "${c_bold}KaMcEs${c_off} $*"; }
note() { echo "   ${c_dim}$*${c_off}"; }

logdir_for() { local d="$LOGS/$1"; mkdir -p "$d"; echo "$d"; }

# PRE-VOO DOS .R. Um erro de parse num .R nao aparece ao editar: aparece
# depois do qsub, em todas as tarefas ao mesmo tempo. Custa milissegundos.
pre_voo_r() {
    python3 "$HERE/stages/checkr.py" "$@" >/dev/null 2>&1 && return 0
    python3 "$HERE/stages/checkr.py" "$@" >&2
    kamces_die "corrija o(s) .R acima antes de submeter"
}

# =========================== OS DOIS EIXOS =================================
#
# 1) QUAIS CATALOGOS servem de referencia
#      --normal    {especie}                completos
#      --uniform   {especie}_uniformizado   profundidade equivalente a spontaneum
#      --all       os dois  (padrao)
#
# 2) QUAIS CROMOSSOMOS entram como consulta
#      --genomas principal    os hibridos do GENOME_DIR  (padrao)
#      --genomas validacao    os cromossomos de identidade CONHECIDA
#                             (officinarum e spontaneum), para conferir se o
#                             metodo acerta onde a resposta ja se sabe
#      --genomas ambos        os dois
#
# As quatro combinacoes tem pastas separadas: sao experimentos diferentes e os
# numeros nao se comparam entre si.

# Eixo 1. Ecoa a lista, na ordem canonica.
conjuntos_de() {
    local n="" u=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --normal)  n=1 ;;
            --uniform|--uniformizado) u=1 ;;
            --all)     n=1; u=1 ;;
        esac
        shift
    done
    [ -z "$n$u" ] && { n=1; u=1; }       # sem flag = --all
    printf '%s' "${n:+normal }${u:+uniform }"
}

# Eixo 2. O padrao e SO o principal: a validacao e uma conferencia pontual,
# nao algo para dobrar o tamanho de toda submissao sem voce pedir.
genomas_de() {
    local escolha="principal"
    while [ $# -gt 0 ]; do
        if [ "$1" = "--genomas" ]; then
            case "${2:-}" in
                principal|principais) escolha="principal" ;;
                validacao|valid)      escolha="validacao" ;;
                ambos|todos|all)      escolha="principal validacao" ;;
                *) kamces_die "--genomas aceita: principal, validacao ou ambos" ;;
            esac
        fi
        shift
    done
    printf '%s' "$escolha"
}

# Tira as flags dos dois eixos de "$@", para o resto do parser nao tropecar.
sem_flags_conjunto() {
    local out=() pula=""
    while [ $# -gt 0 ]; do
        if [ -n "$pula" ]; then pula=""; shift; continue; fi
        case "$1" in
            --normal|--uniform|--uniformizado|--all) ;;
            --genomas) pula=1 ;;
            *) out+=("$1") ;;
        esac
        shift
    done
    # NADA quando sobrou nada. Um `printf '%s\n'` com array vazio imprime uma
    # LINHA VAZIA, o mapfile de quem chama vira um elemento "" e esse ""
    # chegava ao comando seguinte como argumento de verdade.
    if [ "${#out[@]}" -gt 0 ]; then printf '%s\n' "${out[@]}"; fi
    return 0
}

# Existe .sig para este rotulo em TODAS as combinacoes de k x scaled?
_rotulo_completo() {
    local rot="$1" k sc
    for k in $KS; do for sc in $SCALEDS; do
        [ -s "$CATALOGS_DIR/${rot}_${k}_scaled${sc}.sig" ] || return 1
    done; done
    return 0
}

# OS ROTULOS DE REFERENCIA, resolvidos contra o disco AGORA.
#
# Resolver aqui, e nao dentro do job, tem dois motivos: a lista fica visivel no
# log da submissao, e vai congelada no instantaneo - o job nao depende de o
# disco continuar igual quando a tarefa comecar.
rotulos_de() {
    local conj="$1" sp saida="" faltando=""
    case "$conj" in
        normal)
            for sp in $SPECIES; do saida="${saida:+$saida,}$sp"; done ;;
        uniform)
            # spontaneum e a referencia de profundidade: ele NAO tem
            # _uniformizado, e entra na sua unica versao. Isso e o desenho,
            # nao uma falta.
            for sp in $SPECIES; do
                if _rotulo_completo "${sp}_uniformizado"; then
                    saida="${saida:+$saida,}${sp}_uniformizado"
                elif _rotulo_completo "$sp"; then
                    saida="${saida:+$saida,}$sp"
                else
                    faltando="${faltando:+$faltando, }$sp"
                fi
            done ;;
    esac
    [ -n "$faltando" ] && note "conjunto $conj: sem catalogo para $faltando" >&2
    printf '%s' "$saida"
}

# As pastas de cada combinacao (referencia x genomas).
_sufixo_par() {   # $1 = conjunto   $2 = genomas
    local s=""
    [ "$2" = "validacao" ] && s="_valid"
    [ "$1" = "uniform" ]   && s="${s}_uniformizado"
    printf '%s' "$s"
}
indices_de() {
    local base="$INDEXES_DIR" suf; suf="$(_sufixo_par "$1" "$2")"
    case "$suf" in
        "")                   printf '%s' "$INDEXES_DIR" ;;
        _uniformizado)        printf '%s' "${INDEXES_UNIF_DIR:-${base}_uniformizado}" ;;
        _valid)               printf '%s' "${INDEXES_VALID_DIR:-${base}_valid}" ;;
        _valid_uniformizado)  printf '%s' "${INDEXES_VALID_UNIF_DIR:-${base}_valid_uniformizado}" ;;
    esac
}
graficos_de() {
    local base="$PLOTS_SIM_DIR" suf; suf="$(_sufixo_par "$1" "$2")"
    case "$suf" in
        "")                   printf '%s' "$PLOTS_SIM_DIR" ;;
        _uniformizado)        printf '%s' "${PLOTS_UNIF_DIR:-${base}_uniformizado}" ;;
        _valid)               printf '%s' "${PLOTS_VALID_DIR:-${base}_valid}" ;;
        _valid_uniformizado)  printf '%s' "${PLOTS_VALID_UNIF_DIR:-${base}_valid_uniformizado}" ;;
    esac
}

# OS FASTA DE UM EIXO 2, como linhas "rotulo<TAB>caminho".
#
# O rotulo vira PREFIXO do nome do cromossomo na saida. Sem ele, o Chr01 de
# officinarum e o Chr01 de spontaneum - que existem os dois, com o mesmo
# nome - cairiam na MESMA pasta e uma tarefa sobrescreveria a outra.
# Os FASTA de uma pasta, pelos PADROES pedidos.
#
# A pasta do spontaneum tem, alem dos 10 cromossomos em .fa, um .fasta do
# Chr01 e dois arquivos de outra nomenclatura (Cr01AD-sp.fa). Filtrar por
# extensao pegava os quatro e o Chr01 colidia consigo mesmo. Com
# GENOME_VALID_PADRAO="Chr*.fa" entram exatamente os 10 que interessam.
_acha_fasta() {   # $1 = pasta   $2 = lista de padroes separados por espaco
    local d="$1" pats="$2" expr=() pat primeiro=1
    for pat in $pats; do
        [ "$primeiro" = 1 ] && primeiro=0 || expr+=(-o)
        expr+=(-iname "$pat")
    done
    [ "${#expr[@]}" -gt 0 ] || return 0
    find "$d" -maxdepth 1 -type f \( "${expr[@]}" \) -print0 | sort -z
}

fastas_de() {
    local genoma="$1" d rot par
    local pad_princ="${GENOME_PADRAO:-*.fa *.fasta *.fa.gz *.fasta.gz}"
    local pad_valid="${GENOME_VALID_PADRAO:-$pad_princ}"
    if [ "$genoma" = "principal" ]; then
        [ -d "$GENOME_DIR" ] || { note "GENOME_DIR nao existe: $GENOME_DIR" >&2; return 0; }
        while IFS= read -r -d '' f; do printf '\t%s\n' "$f"; done \
            < <(_acha_fasta "$GENOME_DIR" "$pad_princ")
        return 0
    fi
    # validacao: pares rotulo:caminho no GENOME_VALID_DIRS
    for par in ${GENOME_VALID_DIRS:-}; do
        rot="${par%%:*}"; d="${par#*:}"
        if [ "$rot" = "$d" ]; then
            note "GENOME_VALID_DIRS: '$par' nao esta no formato rotulo:caminho" >&2
            continue
        fi
        if [ ! -d "$d" ]; then note "genomas de validacao: $d nao existe" >&2; continue; fi
        while IFS= read -r -d '' f; do printf '%s\t%s\n' "$rot" "$f"; done \
            < <(_acha_fasta "$d" "$pad_valid")
    done
}

# LISTA DE CROMOSSOMOS PARA UM ESTAGIO DE GRAFICO.
#   $1 pasta de entrada   $2 pasta de saida   $3 manifesto   $4 valor do --sample
#
# O --sample aceita as duas formas que fazem sentido:
#   --sample 3                 os 3 primeiros, em ordem alfabetica
#   --sample Chr01_Hap1        so esse
#   --sample Chr01_Hap1,Chr02_Hap1   esses dois
# Vazio = todos. A ordem alfabetica e de proposito: "os 3 primeiros" tem que
# dar os MESMOS 3 toda vez, senao nao da para comparar duas rodadas.
# ACRESCENTA ao manifesto (nao trunca): com --all sao tres chamadas, uma por
# conjunto. Quem chama e que zera o arquivo antes da primeira.
monta_manifesto_parquet() {
    local src="$1" dst="$2" m="$3" amostra="${4:-}" rot="${5:-}"
    local todas=() d
    while IFS= read -r -d '' d; do
        if find "$d" -maxdepth 1 -type f -name '*.parquet' -print -quit | grep -q .; then
            todas+=("$d")
        fi
    done < <(find "$src" -mindepth 1 -maxdepth 1 -type d -print0 | sort -z)
    if [ "${#todas[@]}" -eq 0 ]; then
        note "${rot:+$rot: }nenhuma pasta com .parquet em $src"
        return 0
    fi

    local escolhidas=()
    if [ -z "$amostra" ]; then
        escolhidas=("${todas[@]}")
    else
        case "$amostra" in
            ''|*[!0-9]*)
                # nomes de cromossomo, separados por virgula ou espaco
                local nome achou faltando=""
                for nome in ${amostra//,/ }; do
                    achou=""
                    for d in "${todas[@]}"; do
                        if [ "$(basename "$d")" = "$nome" ]; then
                            escolhidas+=("$d"); achou=1; break
                        fi
                    done
                    [ -n "$achou" ] || faltando="${faltando:+$faltando, }$nome"
                done
                if [ -n "$faltando" ]; then
                    note "nao achei em $src: $faltando"
                    note "existem ${#todas[@]}; os 5 primeiros:"
                    for d in "${todas[@]:0:5}"; do note "  $(basename "$d")"; done
                    kamces_die "--sample nao casou com essas pastas"
                fi ;;
            *)
                [ "$amostra" -gt 0 ] || kamces_die "--sample precisa ser > 0"
                local i=0
                for d in "${todas[@]}"; do
                    [ "$i" -ge "$amostra" ] && break
                    escolhidas+=("$d"); i=$(( i + 1 ))
                done ;;
        esac
    fi
    for d in "${escolhidas[@]}"; do printf '%s\t%s\n' "$d" "$dst" >> "$m"; done
    if [ -n "$amostra" ]; then
        note "${rot:+$rot: }--sample: ${#escolhidas[@]} de ${#todas[@]} cromossomo(s)"
    else
        note "${rot:+$rot: }${#escolhidas[@]} cromossomo(s)"
    fi
}

# PYTHON COM SOURMASH NO NO DE LOGIN.
#
# Os .job chamam kamces_require_python e por isso enxergam o sourmash; os
# comandos que rodam AQUI (hist --local, derivar, bench) nao
# chamavam nada, e o python3 pelado do no de login nao tem sourmash - o
# sintoma era um "sourmash e necessario" seco, antes de ler qualquer arquivo.
# Esta funcao carrega a mesma combinacao de modulos que os jobs usam, uma vez
# por execucao. O `module` referencia variaveis nao definidas, entao vai
# dentro do sem_set_u.
_py_pronto=""
py_local() {
    [ -n "$_py_pronto" ] && return 0
    # A sonda vai num SUBSHELL de proposito: o kamces_require_python termina
    # com `exit 1` quando nao acha nada, e isso mataria o driver antes de a
    # dica abaixo ser impressa. So depois de saber que da certo e que ele e
    # chamado de verdade, aqui, onde o `module load` precisa valer.
    if ! ( sem_set_u kamces_require_python "$@" ) >/dev/null 2>&1; then
        kamces_die "nao achei neste no um python3 que importe: $*
  Este comando roda AQUI, nao na fila. No no de login o modulo costuma nao
  estar carregado. Saidas:
    - abra uma sessao interativa (qlogin) e rode de novo; ou
    - ./kamces doctor   para ver o que cada estagio enxerga; ou
    - ./kamces setup    para instalar as dependencias em \$PY_PKGS."
    fi
    _py_pronto=1
    sem_set_u kamces_require_python "$@" >&2
}

# Recursos do qsub, montados uma vez a partir do config.
#
# H_VMEM VAZIO = nenhum limite e pedido. Isso e legitimo e as vezes ajuda:
# h_vmem e RLIMIT_AS, ou seja, ESPACO DE ENDERECAMENTO VIRTUAL, nao memoria
# residente. numpy, Arrow e sourmash reservam mapeamentos virtuais grandes que
# nunca chegam a ser tocados; um job pode bater no h_vmem usando uma fracao
# daquilo de RAM de verdade. E exatamente essa a cara do
# "ArrowMemoryError: malloc of size N failed".
#
# O preco de nao pedir nada: o SGE deixa de ter como espacar os jobs pelos
# nos, e quem mata passa a ser o OOM killer do Linux - SIGKILL seco, sem
# traceback, exit 137. Por isso existe o MEM_FREE: ele nao limita o processo,
# so informa ao escalonador quanta RAM o job precisa encontrar livre.
QSUB_L=()
_l=""
[ -n "${H_VMEM:-}" ]   && _l="${_l:+$_l,}h_vmem=$H_VMEM"
[ -n "${MEM_FREE:-}" ] && _l="${_l:+$_l,}mem_free=$MEM_FREE"
[ -n "${H_RT:-}" ]     && _l="${_l:+$_l,}h_rt=$H_RT"
[ -n "$_l" ] && QSUB_L=(-l "$_l")
unset _l

# 'module' e uma funcao de shell gerada pelo /etc/profile.d/modules.sh e
# referencia variaveis que podem estar indefinidas. Este driver roda sob
# 'set -euo pipefail', entao chamar module (ou quem chama module) direto daqui
# derruba o script com "unbound variable". Nos .job isso nao acontece porque la
# o carregamento vem ANTES do set -u. Aqui desligamos por um instante.
sem_set_u() {
    local rc=0
    set +eu
    "$@" || rc=$?
    set -eu
    return $rc
}

# Submete um array e devolve o job id puro.
# Diz uma vez, por execucao, o que esta sendo pedido a fila. Sem isso, "tirei
# o h_vmem" e uma alteracao invisivel no log.
_recursos_ditos=""
diz_recursos() {
    [ -n "$_recursos_ditos" ] && return 0
    _recursos_ditos=1
    # >&2 OBRIGATORIO: o submit() tem a saida capturada por $( ), e qualquer
    # coisa impressa aqui vira parte do "job id". Foi exatamente isso que
    # quebrou o encadeamento do reparo: o -hold_jid recebeu o texto do aviso
    # junto do numero, o SGE tratou aquilo como NOME de job, nao achou nenhum
    # com esse nome, e simplesmente nao segurou nada - as quatro fases
    # dispararam juntas, sem um unico erro no log.
    if [ ${#QSUB_L[@]} -eq 0 ]; then
        note "recursos: nenhum limite pedido a fila (sem h_vmem/mem_free/h_rt)" >&2
    else
        note "recursos: ${QSUB_L[1]}" >&2
    fi
}

# Um id de job e so digitos. Qualquer outra coisa aqui significa que a saida
# do qsub veio contaminada - e um -hold_jid com lixo dentro NAO da erro: o SGE
# interpreta como nome de job, nao encontra, e segue sem segurar.
jid_ok() {
    local j="$1" onde="$2"
    case "$j" in
        ""|*[!0-9]*)
            kamces_die "id de job invalido vindo de $onde: '$j'
  Isso costuma ser saida de texto capturada junto com o numero.
  NAO submeta o encadeamento assim: os -hold_jid nao seguram nada." ;;
    esac
}

# O submit() roda dentro de $( ) - um SUBSHELL. Variavel atribuida la dentro
# nao chega aqui, entao o caminho do instantaneo e publicado em ARQUIVO. Um
# `ULTIMO_SNAP=...` dentro do submit compilaria, rodaria, e deixaria os jobs
# encadeados apontando para "/stages/x.job".
TC_ESTAGIO=""    # -tc especifico de um estagio; vazio = MAX_JOBS
ULTIMO_SNAP_ARQ="$MANIFEST_DIR/.ultimo_instantaneo"
ultimo_snap() {
    local d=""
    [ -f "$ULTIMO_SNAP_ARQ" ] && d="$(cat "$ULTIMO_SNAP_ARQ")"
    [ -n "$d" ] && [ -d "$d" ] || kamces_die \
        "nao achei o instantaneo da submissao anterior ($ULTIMO_SNAP_ARQ).
  Os jobs encadeados precisam dele. Isto e um bug - reporte."
    printf '%s\n' "$d"
}

# INSTANTANEO DA SUBMISSAO.
#
# O que o job recebe do qsub sao CAMINHOS - do config.sh, do manifesto, da
# lib - e ele le esses arquivos quando a TAREFA COMECA, nao quando voce
# submete. Com -tc 8 e um array de 48, as ultimas tarefas comecam horas
# depois. Sem congelar nada, tres coisas davam errado em silencio:
#
#   1. editar o config.sh no meio faria metade do array rodar com um KS e a
#      outra metade com outro;
#   2. submeter o mesmo estagio de novo sobrescreve o manifesto - que tem
#      caminho fixo por estagio - e o array anterior passaria a ler as linhas
#      do novo, pegando a especie errada;
#   3. instalar uma versao nova do KaMcEs por cima trocaria o .job e o .py
#      debaixo das tarefas que ainda nao comecaram.
#
# Por isso cada submissao copia config + manifesto + lib + stages para uma
# pasta datada e aponta o qsub para LA. Depois disso o array e imune: voce
# pode editar o config, resubmeter e ate reinstalar o pacote sem tocar no que
# ja esta na fila. Custa ~1 MB por submissao.
instantaneo() {
    local name="$1" manifest="$2"
    local snap="$MANIFEST_DIR/instantaneos/${name}.$(date +%Y%m%d-%H%M%S).$$"
    mkdir -p "$snap"
    cp    "$KAMCES_CONFIG" "$snap/config.sh"
    [ -n "$manifest" ] && [ -f "$manifest" ] && cp "$manifest" "$snap/manifest.tsv"
    cp -r "$HERE/lib"      "$snap/lib"
    cp -r "$HERE/stages"   "$snap/stages"
    # Guarda tambem os manifestos auxiliares do estagio (o reparar usa lista de
    # bloqueados e um segundo manifesto), para o instantaneo ficar completo.
    local aux
    for aux in "$MANIFEST_DIR"/reparar_*.tsv "$MANIFEST_DIR"/reparar_*.txt; do
        [ -f "$aux" ] && cp "$aux" "$snap/" 2>/dev/null || true
    done
    printf '%s\n' "$snap"
}

# Mantem so os 40 instantaneos mais recentes.
poda_instantaneos() {
    local base="$MANIFEST_DIR/instantaneos"
    [ -d "$base" ] || return 0
    local velhos
    velhos=$(ls -1dt "$base"/*/ 2>/dev/null | tail -n +41 || true)
    [ -n "$velhos" ] && printf '%s\n' "$velhos" | xargs -r rm -rf || true
}

# As variaveis que apontam um job para um instantaneo. Os qsub que nao passam
# pelo submit() (pintura, hist, o merge do catalogs-ms) usam
# isto para ficar congelados do mesmo jeito.
env_do_snap() {
    printf 'CONFIG_FILE=%s/config.sh,KAMCES_LIB=%s/lib,KAMCES_DIR=%s,STAGES=%s/stages' \
           "$1" "$1" "$1" "$1"
}

submit() {
    local name="$1" tasks="$2" manifest="$3"; shift 3
    diz_recursos
    local ld; ld="$(logdir_for "$name")"
    local extra=("$@")
    local snap; snap="$(instantaneo "$name" "$manifest")"
    printf '%s\n' "$snap" > "$ULTIMO_SNAP_ARQ"   # ver ultimo_snap(): subshell
    # >&2 OBRIGATORIO, pelo mesmo motivo do diz_recursos: a saida do submit()
    # e capturada por $( ) e vira o job id. Um `note` em stdout aqui contamina
    # o id, e um -hold_jid com lixo dentro NAO da erro - so nao segura nada.
    note "instantaneo: $snap" >&2
    poda_instantaneos
    # ${arr[@]+"${arr[@]}"}: em bash < 4.4 (CentOS 7) um "${arr[@]}" vazio
    # dispara "unbound variable" sob set -u.
    qsub -terse -N "kamces_$name" -q "$QUEUE" ${QSUB_L[@]+"${QSUB_L[@]}"} \
         -o "$ld" -e "$ld" -t 1-"$tasks" -tc "${TC_ESTAGIO:-$MAX_JOBS}" \
         -v MANIFEST="$snap/manifest.tsv",KAMCES_LISTA="$snap/manifest.tsv",KAMCES_LISTA_LINHAS="$(wc -l < "$snap/manifest.tsv" | tr -d ' ')",CONFIG_FILE="$snap/config.sh",KAMCES_LIB="$snap/lib",KAMCES_DIR="$snap",STAGES="$snap/stages" \
         ${extra[@]+"${extra[@]}"} "$snap/stages/$name.job" | head -1 | cut -d. -f1
}

