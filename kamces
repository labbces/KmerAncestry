# Confere as referencias de UM conjunto (ou do normal, sem flag).
cmd_refs() {
    local conjs; conjs="$(conjuntos_de "$@")"
    local resto; mapfile -t resto < <(sem_flags_conjunto "$@")
    # Sem flag nenhuma, `conjuntos_de` devolve os dois; aqui o util e conferir
    # so o normal quando o usuario nao pediu nada.
    case " $* " in *" --"*) ;; *) conjs="normal" ;; esac
    local c rot rc=0
    for c in $conjs; do
        rot="$(rotulos_de "$c")"
        if [ -z "$rot" ]; then
            note "conjunto $c: nenhum catalogo - pulando"
            continue
        fi
        [ "$conjs" = "normal" ] || say "conjunto $c: ${rot//,/ }"
        python3 "$HERE/stages/checkrefs.py" \
            --catalogs-dir "$CATALOGS_DIR" \
            --species ${rot//,/ } --ks $KS --scaleds $SCALEDS \
            ${resto[@]+"${resto[@]}"} || rc=1
    done
    return $rc
}

# ------------------------------------------------------------------ sliding --
# MONTA O MANIFESTO IDEAL DO SLIDING: tudo o que DEVERIA existir.
#   $1 manifesto   $2 conjuntos   $3 genomas   $4 --sample   $5 "" ou "quieto"
# Uma funcao so, usada pelo sliding E pelo refazer: e o unico jeito de a lista
# que se refaz ser exatamente a lista que se produz.
#   $6 "so-existentes" = pula combinacao cuja pasta de saida nem existe
monta_manifesto_sliding() {
    local m="$1" conjs="$2" gens="$3" amostra="${4:-}" quieto="${5:-}"
    local so_existentes="${6:-}"
    : > "$m"
    local c g rot destino antes agora n_fasta
    for g in $gens; do
        # Os FASTA deste eixo, uma vez por eixo (nao por conjunto).
        local pares=(); local linha
        while IFS= read -r linha; do [ -n "$linha" ] && pares+=("$linha"); done \
            < <(fastas_de "$g")
        if [ "${#pares[@]}" -eq 0 ]; then
            note "$g: nenhum FASTA encontrado - pulando"
            continue
        fi
        # QUANTOS DE CADA ROTULO. "23 FASTA" nao diz nada; "of=13 sp=10" diz
        # na hora que uma das pastas tem arquivo a mais do que voce espera.
        if [ -z "$quieto" ]; then
            local contagem="" rl
            for rl in $(printf '%s\n' "${pares[@]}" | cut -f1 | sort -u); do
                contagem="${contagem:+$contagem }${rl:-(principal)}=$(printf '%s\n' "${pares[@]}" | cut -f1 | grep -cx "$rl")"
            done
            [ -n "${contagem// /}" ] && note "$g: ${#pares[@]} FASTA ($contagem)"
        fi
        for c in $conjs; do
            rot="$(rotulos_de "$c")"
            if [ -z "$rot" ]; then
                note "$c: nenhum catalogo com esse padrao de nome - pulando"
                continue
            fi
            destino="$(indices_de "$c" "$g")"
            # ARVORE QUE NUNCA RODOU. O sliding cria a pasta de saida conforme
            # avanca; se a raiz nem existe, aquela combinacao nao foi rodada
            # ainda - e "refazer" o que nunca comecou nao e refazer, e comecar.
            # Sem isto, o refazer enfiava as 1260 tarefas da arvore que voce
            # ainda nao quer no meio das que voce quer de volta.
            if [ -n "$so_existentes" ] && [ ! -d "$destino" ]; then
                note "$g x $c: $destino nao existe - nao rodou ainda, pulando"
                continue
            fi
            if [ -z "$quieto" ]; then
                note "$g x $c -> referencias: ${rot//,/ }"
                note "$g x $c -> saida: $destino"
            fi
            antes=$(wc -l < "$m"); n_fasta=0
            # DOIS FASTA COM O MESMO NOME DE SAIDA. Acontece de verdade: uma
            # pasta com Chr01.fa e Chr01.fasta do mesmo cromossomo colapsa no
            # mesmo "stem" e as duas tarefas escreveriam o MESMO Parquet.
            # Aqui guardamos QUAL arquivo gerou cada nome, para a mensagem
            # poder apontar a causa.
            local -A DE_ONDE=()
            local vistos=0 p rotf fasta stem
            for p in "${pares[@]}"; do
                rotf="${p%%$'\t'*}"; fasta="${p#*$'\t'}"
                stem="$(basename "$fasta")"; stem="${stem%.gz}"; stem="${stem%.*}"
                # PREFIXO DO ROTULO. of/Chr01 e sp/Chr01 existem os dois, com
                # o mesmo nome: sem isto, uma tarefa sobrescreveria a outra.
                [ -n "$rotf" ] && stem="${rotf}_${stem}"
                if [ -n "$amostra" ]; then
                    case "$amostra" in
                        ''|*[!0-9]*)
                            local quer="" nome
                            for nome in ${amostra//,/ }; do
                                [ "$nome" = "$stem" ] && quer=1
                            done
                            [ -n "$quer" ] || continue ;;
                        *)
                            vistos=$(( vistos + 1 ))
                            [ "$vistos" -le "$amostra" ] || continue ;;
                    esac
                fi
                if [ -n "${DE_ONDE[$stem]:-}" ] && [ "${DE_ONDE[$stem]}" != "$fasta" ]; then
                    kamces_die "dois FASTA dao o mesmo nome de saida ('$stem'):
    ${DE_ONDE[$stem]}
    $fasta
  Os dois escreveriam $destino/$stem/ - decida qual vale e tire o outro da
  pasta, ou filtre com GENOME_VALID_PADRAO / GENOME_PADRAO no config.sh."
                fi
                DE_ONDE[$stem]="$fasta"
                n_fasta=$(( n_fasta + 1 ))
                for k in $KS; do for sc in $SCALEDS; do
                    # A 5a coluna e a lista de referencias: e ela que faz a
                    # mesma tarefa comparar contra os catalogos certos.
                    printf '%s\t%s\t%s\t%s\t%s\n' "$fasta" \
                           "$destino/$stem/${stem}_k${k}_sc${sc}.parquet" "$k" "$sc" "$rot" >> "$m"
                done; done
            done
            agora=$(wc -l < "$m")
            [ -z "$quieto" ] && note "$g x $c: $n_fasta FASTA${amostra:+ (--sample $amostra)} x $(echo $KS|wc -w) k x $(echo $SCALEDS|wc -w) scaled = $(( agora - antes )) tarefa(s)"
        done
    done
    # Destino repetido significa duas tarefas escrevendo o mesmo Parquet - o
    # tipo de erro que so aparece como arquivo corrompido, horas depois.
    local dup; dup=$(cut -f2 "$m" | sort | uniq -d | head -3)
    if [ -n "$dup" ]; then
        echo "KaMcEs: destinos repetidos no manifesto:" >&2
        printf '%s\n' "$dup" | while IFS= read -r d; do
            [ -n "$d" ] || continue
            echo "  $d" >&2
            grep -F "	$d	" "$m" | cut -f1 | sed 's/^/      vindo de: /' >&2
        done
        kamces_die "duas tarefas escreveriam o mesmo Parquet - corrija antes de submeter"
    fi
}

# Confere as referencias de cada conjunto pedido, antes de submeter nada.
pre_voo_refs() {
    [ "${PULAR_REFS:-no}" = "yes" ] && return 0
    local c rot
    for c in $1; do
        rot="$(rotulos_de "$c")"
        [ -n "$rot" ] || continue
        if ! python3 "$HERE/stages/checkrefs.py" --catalogs-dir "$CATALOGS_DIR" \
               --species ${rot//,/ } --ks $KS --scaleds $SCALEDS >/dev/null 2>&1; then
            python3 "$HERE/stages/checkrefs.py" --catalogs-dir "$CATALOGS_DIR" \
               --species ${rot//,/ } --ks $KS --scaleds $SCALEDS || true
            echo >&2
            kamces_die "conjunto $c: as assinaturas de referencia nao casam (veja acima).
  Para submeter assim mesmo: PULAR_REFS=yes ./kamces sliding"
        fi
    done
}

cmd_sliding() {
    local conjs; conjs="$(conjuntos_de "$@")"
    local gens;  gens="$(genomas_de "$@")"
    local args;  mapfile -t args < <(sem_flags_conjunto "$@")
    set -- ${args[@]+"${args[@]}"}
    # --sample: quantos cromossomos, ou quais. Um cromossomo sao 12 tarefas em
    # vez de 1260 - o jeito barato de ver se uma combinacao nova produz o que
    # voce espera antes de soltar tudo.
    local amostra=""
    local resto=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --sample) amostra="${2:-}"
                      [ $# -ge 2 ] && shift 2 || shift ;;
            *) resto+=("$1"); shift ;;
        esac
    done
    local m="$MANIFEST_DIR/sliding.tsv"
    say "02 sliding: referencias {${conjs% }}  genomas {$gens}"
    pre_voo_refs "$conjs"
    monta_manifesto_sliding "$m" "$conjs" "$gens" "$amostra"

    local n; n=$(wc -l < "$m")
    [ "$n" -gt 0 ] || kamces_die "nada a submeter (nenhum FASTA, ou nenhum catalogo)"
    note "TOTAL: $n tarefa(s)"
    JID_SLIDING=$(submit sliding "$n" "$m" ${resto[@]+"${resto[@]}"})
    jid_ok "$JID_SLIDING" "sliding"
    note "job $JID_SLIDING"
}


cmd_plots() {
    # --metricas / --escalas restringem o QUE sai; --sample restringe DE QUAIS
    # cromossomos. Cada imagem tem 8400x3600 px: rodar tudo nos 105
    # cromossomos e caro quando voce so quer ver se ficou bom.
    local metricas="${KAMCES_METRICAS:-}" escalas="${KAMCES_ESCALAS:-}" amostra=""
    local conjs; conjs="$(conjuntos_de "$@")"
    local gens;  gens="$(genomas_de "$@")"
    local args; mapfile -t args < <(sem_flags_conjunto "$@")
    set -- ${args[@]+"${args[@]}"}
    while [ $# -gt 0 ]; do
        case "$1" in
            --metricas) metricas="${2:-}"
                        [ $# -ge 2 ] && shift 2 || shift ;;
            --escalas)  escalas="${2:-}"
                        [ $# -ge 2 ] && shift 2 || shift ;;
            --sample)   amostra="${2:-}"
                        [ $# -ge 2 ] && shift 2 || shift ;;
            --so-contencao) metricas="contencao"; escalas="normal"; shift ;;
            *) break ;;
        esac
    done
    pre_voo_r "$HERE/stages/plots.R"
    local m="$MANIFEST_DIR/plots.tsv"
    : > "$m"
    local c g src dst
    for g in $gens; do for c in $conjs; do
        src="$(indices_de "$c" "$g")"; dst="$(graficos_de "$c" "$g")"
        if [ ! -d "$src" ]; then note "$g x $c: $src nao existe, pulando"; continue; fi
        mkdir -p "$dst"
        monta_manifesto_parquet "$src" "$dst" "$m" "$amostra" "$g x $c"
    done; done
    local n; n=$(wc -l < "$m")
    [ "$n" -gt 0 ] || kamces_die "nenhuma pasta com .parquet para plotar"
    say "04 graficos: $n tarefa(s)"
    [ -n "$metricas" ] && note "metricas: $metricas"
    [ -n "$escalas" ]  && note "escalas : $escalas"
    # Exportadas em vez de passadas num segundo -v: o plots.job tem #$ -V, que
    # leva o ambiente de quem submeteu. Empilhar dois -v no mesmo qsub e um
    # comportamento que varia entre versoes do Grid Engine, e este pipeline ja
    # perdeu tempo demais com detalhe de qsub.
    export KAMCES_METRICAS="$metricas" KAMCES_ESCALAS="$escalas"
    JID_PLOTS=$(submit plots "$n" "$m" "$@")
    jid_ok "$JID_PLOTS" "plots"
    note "job $JID_PLOTS"
}


# ---------------------------------------------------------------------- all --
# O pipeline inteiro, encadeado por -hold_jid: catalogos -> janela -> graficos.
#
# As flags de conjunto (--normal/--uniform/--valid/--all) valem para o sliding
# e para os graficos, e NAO sao repassadas ao catalogs-ms, que nao as conhece:
# ele monta os tres tipos de catalogo de uma vez so.
cmd_all() {
    local conj; mapfile -t conj < <(printf '%s\n' "$@" | grep -E '^--(normal|uniform|uniformizado|valid|validacao|all)$' || true)
    local resto; mapfile -t resto < <(sem_flags_conjunto "$@")
    cmd_catalogs_ms ${resto[@]+"${resto[@]}"} --all --uniforme
    cmd_sliding ${conj[@]+"${conj[@]}"} -hold_jid "$JID_CAT_MS_MERGE"
    cmd_plots   ${conj[@]+"${conj[@]}"} -hold_jid "$JID_SLIDING"
    say "pipeline completo submetido"
}


# ------------------------------------------------------------------ refazer --
cmd_refazer() {
    # TODAS as arvores QUE JA EXISTEM, por padrao. Duas coisas de uma vez:
    # conferir so a "normal" era o jeito de deixar 400 tarefas perdidas nas
    # outras; e incluir uma arvore que voce ainda nao rodou seria enfiar 1260
    # tarefas novas no meio das que voce quer de volta.
    #
    #   ./kamces refazer                        as arvores que existem
    #   ./kamces refazer --uniform              so as de catalogo uniformizado
    #   ./kamces refazer --genomas validacao    so as dos cromossomos de teste
    #   ./kamces refazer --tudo                 inclui as que nunca rodaram
    local conjs; conjs="$(conjuntos_de "$@")"
    # Sem --genomas, o refazer olha os DOIS eixos; com --genomas, obedece.
    # (`genomas_de` sozinho tem `principal` como padrao, que aqui seria
    # esquecer metade das arvores.)
    local gens
    case " $* " in
        *" --genomas "*) gens="$(genomas_de "$@")" ;;
        *)               gens="principal validacao" ;;
    esac
    local args;  mapfile -t args < <(sem_flags_conjunto "$@")
    set -- ${args[@]+"${args[@]}"}
    local amostra="" apagar=1 estados="" tc="$MAX_JOBS" tudo="" varrer=""
    local nivel="exata" forcar=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --sample)      amostra="${2:-}"; [ $# -ge 2 ] && shift 2 || shift ;;
            --estados)     estados="${2:-}"; [ $# -ge 2 ] && shift 2 || shift ;;
            --tc)          tc="${2:-}";      [ $# -ge 2 ] && shift 2 || shift ;;
            --sem-apagar)  apagar=""; shift ;;
            # --varrer NAO passa mais estados="NADA": aquilo ia como
            # `--estados NADA` para o checar_sliding.py, que valida o nome
            # contra a lista de estados e morria com "estado(s) invalido(s)".
            # Quem nao submete nada agora e o proprio job, por REFAZER_VARRER.
            --varrer)      apagar=""; varrer=1; shift ;;
            --tudo)        tudo=1; shift ;;
            # NIVEL DA CONFERENCIA. O padrao e o mais preciso; estas duas
            # descem de nivel quando voce quer so uma varrida.
            --rapido)      nivel="rapida"; shift ;;
            --funda)       nivel="funda"; shift ;;
            --forcar)      forcar=1; shift ;;
            *) kamces_die "opcao desconhecida em refazer: $1
  uso: ./kamces refazer [--normal|--uniform|--all] [--genomas ...]
                        [--sample N|nomes] [--estados 'AUSENTE CURTO ...']
                        [--varrer] [--sem-apagar] [--tudo] [--tc N]
                        [--rapido|--funda] [--forcar]

  Por padrao ele confere so as arvores QUE JA EXISTEM em disco - a que voce
  ainda nao rodou nao entra. --tudo inclui tambem as que nunca rodaram.

  A conferencia e EXATA por padrao: rodape do Parquet, leitura das colunas de
  janela e os comprimentos dos FASTA (em cache). --funda dispensa os FASTA,
  --rapido fica so no rodape. --forcar solta o freio de mao que barra uma
  limpeza de mais de 25% dos arquivos existentes." ;;
        esac
    done

    say "refazer: confere as saidas do sliding e re-submete o que falta"
    note "referencias {${conjs% }}  genomas {$gens}"

    # O MANIFESTO IDEAL E MONTADO AQUI, pela MESMA funcao do sliding - e o
    # unico jeito de a lista que se refaz carregar a coluna de referencias
    # certa de cada arvore. E baratinho: so um `find` nas pastas de FASTA.
    local m="$MANIFEST_DIR/refazer_ideal.tsv"
    pre_voo_refs "$conjs"
    # Invertido de proposito: --tudo DESLIGA o filtro. Escrito em duas linhas
    # porque a versao "${tudo:+}${tudo:-so-existentes}" fazia o contrario do
    # que parece - com tudo=1 ela devolve "1", que e nao-vazio, e o filtro
    # ficava LIGADO justamente quando voce pediu para incluir tudo.
    local so_ex="so-existentes"; [ -n "$tudo" ] && so_ex=""
    monta_manifesto_sliding "$m" "$conjs" "$gens" "$amostra" "" "$so_ex"
    local n; n=$(wc -l < "$m")
    [ "$n" -gt 0 ] || kamces_die "nada a conferir (nenhum FASTA, ou nenhum catalogo)"
    note "manifesto ideal: $n combinacao(oes) esperadas"

    # A CONFERENCIA VAI PARA A FILA. Sao milhares de Parquet para abrir no
    # /Storage; nao e servico de no de login. O job confere, apaga o que
    # quebrou e da o qsub do array - o tamanho do array so se sabe depois de
    # conferir, e o SGE precisa do tamanho na submissao.
    local snap; snap="$(instantaneo refazer "$m")"; poda_instantaneos
    note "instantaneo: $snap"
    local ideal="$snap/manifest.tsv"
    local pend="$snap/refazer_pendentes.tsv"
    local ld;  ld="$(logdir_for sliding)"
    local ldr; ldr="$(logdir_for refazer)"
    local recursos=""
    [ ${#QSUB_L[@]} -gt 0 ] && recursos="${QSUB_L[1]}"

    case "$nivel" in
        exata) note "conferencia EXATA: rodape + colunas de janela + comprimentos dos FASTA" ;;
        funda) note "conferencia funda: rodape + colunas de janela (sem ler FASTA)" ;;
        *)     note "conferencia rapida: so o rodape do Parquet" ;;
    esac
    [ -n "$apagar" ] && note "vai APAGAR o que estiver quebrado (o .parts NAO: e trabalho aproveitavel)" \
                     || note "--sem-apagar: so relata, nao apaga nada"
    [ -n "$forcar" ] && note "--forcar: o freio de mao da limpeza esta solto"
    [ -n "$varrer" ] && note "--varrer: so o relatorio, nada sera submetido"

    diz_recursos
    local jid; jid=$(qsub -terse -N kamces_refazer -q "$QUEUE" \
        ${QSUB_L[@]+"${QSUB_L[@]}"} -o "$ldr" -e "$ldr" -t 1-1 -tc 1 \
        -v MANIFEST="$ideal","$(env_do_snap "$snap")",REFAZER_IDEAL="$ideal",REFAZER_PENDENTES="$pend",REFAZER_APAGAR="$apagar",REFAZER_ESTADOS="$estados",REFAZER_VARRER="$varrer",REFAZER_NIVEL="$nivel",REFAZER_FORCAR="$forcar",REFAZER_CACHE="$MANIFEST_DIR/janelas_esperadas.tsv",REFAZER_LOGDIR="$ld",REFAZER_LOGDIR_CONS="$(logdir_for consolidar)",REFAZER_TC="$tc",REFAZER_QUEUE="$QUEUE",REFAZER_L="$recursos" \
        "$snap/stages/refazer.job" | head -1 | cut -d. -f1)
    jid_ok "$jid" "refazer"
    note "job $jid (1 tarefa); log em $ldr"
    note "ele confere, apaga o que quebrou e submete o array do sliding sozinho"
}

# -------------------------------------------------------------------- doctor --
cmd_doctor() {
    # Roda no NO DE EXECUCAO, nao no de login: o que importa e o que o job ve.
    local ld; ld="$(logdir_for doctor)"
    if [ "${1:-}" = "--local" ]; then
        say "doctor (aqui, no no de login)"
        env KAMCES_LIB="$KAMCES_LIB" CONFIG_FILE="$KAMCES_CONFIG" \
            bash "$HERE/stages/doctor.job"
        return 0
    fi
    say "doctor: submetendo ao no de execucao (saida em $ld)"
    note "para rodar aqui mesmo: ./kamces doctor --local"
    qsub -N kamces_doctor -q "$QUEUE" ${QSUB_L[@]+"${QSUB_L[@]}"} -o "$ld" -e "$ld" \
         -v CONFIG_FILE="$KAMCES_CONFIG",KAMCES_LIB="$KAMCES_LIB" \
         "$HERE/stages/doctor.job"
}

# ------------------------------------------------------------------- status --
cmd_status() {
    _count() { find "$1" -type f -name "$2" 2>/dev/null | wc -l; }
    local nk nsc esperado
    nk=$(echo $KS | wc -w); nsc=$(echo $SCALEDS | wc -w)
    local nfasta; nfasta=$(find "$GENOME_DIR" -maxdepth 1 -type f \
        \( -iname '*.fa' -o -iname '*.fasta' -o -iname '*.fa.gz' -o -iname '*.fasta.gz' \) 2>/dev/null | wc -l)
    esperado=$(( nfasta * nk * nsc ))
    printf '%s\n' "${c_bold}KaMcEs - situacao${c_off}"
    printf '  %-26s %s\n' "FASTA de entrada" "$nfasta"
    printf '  %-26s %s / %s\n' "catalogos (.sig)" \
        "$(_count "$CATALOGS_DIR" '*.sig')" "$(( $(echo $SPECIES|wc -w) * nk * nsc ))"
    printf '  %-26s %s / %s\n' "similaridades (.parquet)" \
        "$(_count "$INDEXES_DIR" '*.parquet')" "$esperado"
    printf '  %-26s %s\n' "zips de graficos" "$(_count "$PLOTS_SIM_DIR" '*.zip')"
    local parts; parts=$(find "$INDEXES_DIR" -type d -name '*.parts' 2>/dev/null | wc -l)
    if [ "$parts" -gt 0 ]; then
        printf '  %-26s %s  %s\n' "partes inacabadas" "$parts" \
            "${c_dim}(jobs interrompidos; ./kamces clean-parts para descartar)${c_off}"
    fi
    echo
    qstat -u "${USER:-$(id -un)}" 2>/dev/null | head -15 || true
}

cmd_limpar() {
    python3 "$HERE/stages/limpar.py" --dir "$INDEXES_DIR" "$@"
}

cmd_clean_parts() {
    local found=()
    while IFS= read -r -d '' d; do found+=("$d"); done \
        < <(find "$INDEXES_DIR" -type d -name '*.parts' -print0 2>/dev/null)
    if [ "${#found[@]}" -eq 0 ]; then say "nenhuma parte orfa"; return 0; fi
    say "${#found[@]} pasta(s) de partes inacabadas:"
    printf '   %s\n' "${found[@]:0:10}"
    note "descartar significa recalcular essas janelas - nenhum dado consolidado se perde"
    read -r -p "   remover? [s/N] " r
    [[ "${r,,}" == "s" ]] && { rm -rf "${found[@]}"; say "removidas"; } || say "nada removido"
}

# --------------------------------------------------------------------- main --
case "${1:-}" in
    setup)       shift; cmd_setup "$@" ;;
    catalogs-ms) shift; cmd_catalogs_ms "$@" ;;
    sliding)     shift; cmd_sliding "$@" ;;
    plots)       shift; cmd_plots "$@" ;;
    all)         shift; cmd_all "$@" ;;
    refazer)     shift; cmd_refazer "$@" ;;
    pintura)     shift; cmd_pintura "$@" ;;
    refs)        shift; cmd_refs "$@" ;;
    derivar)     shift; cmd_derivar "$@" ;;
    bench)       shift; cmd_bench "$@" ;;
    bench-ms)    shift; cmd_bench_ms "$@" ;;
    hist)        shift; cmd_hist "$@" ;;
    doctor)      shift; cmd_doctor "$@" ;;
    status)      shift; cmd_status "$@" ;;
    limpar)      shift; cmd_limpar "$@" ;;
    clean-parts) shift; cmd_clean_parts "$@" ;;
    -v|--version|version)
        cat "$HERE/VERSION"
        # Impressao digital calculada AGORA, a partir dos arquivos em disco.
        # O carimbo de build acima e escrito a mao e ja ficou parado entre
        # versoes diferentes - o que torna "qual build eu tenho?" impossivel
        # de responder. Isto aqui nao mente: dois KaMcEs com a mesma soma sao
        # o mesmo codigo, arquivo por arquivo.
        echo
        echo "impressao digital dos arquivos em disco:"
        (
            cd "$HERE" || exit 0
            for f in kamces config.sh.exemplo lib/*.sh lib/*.py \
                     stages/*.py stages/*.sh stages/*.job stages/*.R; do
                [ -f "$f" ] || continue
                printf '  %-28s %s\n' "$f" \
                    "$(md5sum "$f" 2>/dev/null | cut -c1-8)"
            done
            echo "  ----------------------------------------"
            printf '  %-28s %s\n' "CONJUNTO" \
                "$(cat kamces lib/*.sh lib/*.py stages/*.py stages/*.sh \
                       stages/*.job stages/*.R 2>/dev/null \
                   | md5sum | cut -c1-12)"
        )
        # Recursos efetivos: mostra o que este config pediria a fila.
        echo
        if [ ${#QSUB_L[@]} -eq 0 ]; then
            echo "recursos pedidos a fila: NENHUM (H_VMEM/MEM_FREE/H_RT vazios)"
        else
            echo "recursos pedidos a fila: ${QSUB_L[1]}"
        fi
        echo "MAX_JOBS=${MAX_JOBS:-?}  STEP=${STEP:-?}  WINDOW_SIZE=${WINDOW_SIZE:-?}" ;;
    ""|-h|--help|help)
        awk 'NR>1 && /^#/ {sub(/^# ?/,""); print; next} NR>1 {exit}' "$HERE/kamces" ;;
    *) kamces_die "subcomando desconhecido: $1 (use ./kamces --help)" ;;
esac
