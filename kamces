# ------------------------------------------------------------------ pintura --
# Pintura cromossomica: quem ganha em cada trecho, em vez do valor da metrica.
# Existe porque a contencao satura - quase toda janela fica entre 0,9 e 1,0
# com quase toda especie, e o grafico de valor gasta o eixo inteiro mostrando
# que ele nao varia.
cmd_pintura() {
    local metrica="${KAMCES_METRICA_PINTURA:-window_containment_in_reference}"
    local amostra=""
    local conjs; conjs="$(conjuntos_de "$@")"
    local gens;  gens="$(genomas_de "$@")"
    local args; mapfile -t args < <(sem_flags_conjunto "$@")
    set -- ${args[@]+"${args[@]}"}
    while [ $# -gt 0 ]; do
        case "$1" in
            --metrica) metrica="${2:-}"
                       [ $# -ge 2 ] && shift 2 || shift ;;
            --sample)  amostra="${2:-}"
                       [ $# -ge 2 ] && shift 2 || shift ;;
            *) break ;;
        esac
    done
    pre_voo_r "$HERE/stages/pintura.R"
    local m="$MANIFEST_DIR/pintura.tsv"
    : > "$m"
    local c g src dst
    for g in $gens; do for c in $conjs; do
        src="$(indices_de "$c" "$g")"; dst="$(graficos_de "$c" "$g")/pintura"
        if [ ! -d "$src" ]; then note "$g x $c: $src nao existe, pulando"; continue; fi
        mkdir -p "$dst"
        monta_manifesto_parquet "$src" "$dst" "$m" "$amostra" "$g x $c"
        note "$g x $c: saida em $dst"
    done; done
    local n; n=$(wc -l < "$m")
    [ "$n" -gt 0 ] || kamces_die "nenhuma pasta com .parquet em $src"
    say "04b pintura: $n cromossomo(s)"
    note "metrica: $metrica"
    export KAMCES_METRICA_PINTURA="$metrica"
    local j; j=$(submit pintura "$n" "$m" "$@")
    jid_ok "$j" "pintura"
    note "job $j"
}



