# --------------------------------------------------------------------- hist --
# Espectro de abundancia de k-mers dos catalogos, grade k x scaled.
cmd_hist() {
    # --sample escolhe QUANTOS (ou QUAIS) catalogos entram - abrir os .sig e a
    # parte cara. --grades escolhe quais das tres figuras sair.
    local grades="${HIST_GRADES:-}" amostra="" local_="" so_plot=""
    # As MESMAS flags de referencia dos outros comandos. No hist elas escolhem
    # qual das duas grades sair. O eixo 2 (--genomas) nao se aplica: o hist
    # plota CATALOGOS, nao cromossomos.
    local conjs; conjs="$(conjuntos_de "$@")"
    local args; mapfile -t args < <(sem_flags_conjunto "$@")
    set -- ${args[@]+"${args[@]}"}
    while [ $# -gt 0 ]; do
        case "$1" in
            --grades) grades="${2:-}"
                      [ $# -ge 2 ] && shift 2 || shift ;;
            --sample) amostra="${2:-}"
                      [ $# -ge 2 ] && shift 2 || shift ;;
            --local)   local_=1; shift ;;
            --so-plot|--replot) so_plot=1; shift ;;
            *) kamces_die "opcao desconhecida em hist: $1
  uso: ./kamces hist [--normal|--uniform|--all] [--sample N|nomes]
                     [--so-plot] [--local]" ;;
        esac
    done
    # --grades continua valendo e tem precedencia; sem ele, as flags de
    # conjunto viram grades.
    if [ -z "$grades" ]; then
        local g="" c
        for c in $conjs; do
            case "$c" in
                normal)  g="${g:+$g,}especies" ;;
                uniform) g="${g:+$g,}uniformizado" ;;
            esac
        done
        grades="$g"
    fi
    # Pasta propria: a tabela nao entra no meio dos .sig e as figuras nao se
    # misturam com os graficos por cromossomo.
    pre_voo_r "$HERE/stages/hist_kmers.R"
    local hdir="${HIST_DIR:-$DATA/hist}"
    # O --sample muda o CONTEUDO da tabela, entao ele entra no nome dela e no
    # das figuras. Sem isso, uma rodada com --sample sobrescreveria a tabela
    # completa e o --so-plot seguinte desenharia o subconjunto sem avisar.
    local sufa=""
    if [ -n "$amostra" ]; then
        sufa="_sample$(printf '%s' "$amostra" | tr -cd 'A-Za-z0-9,_' | tr ',' '-')"
    fi
    local tsv="$hdir/hist_kmers${sufa}.tsv"
    local png="$hdir/hist_kmers${sufa}.png"
    mkdir -p "$hdir"
    say "espectro de k-mers dos catalogos em $CATALOGS_DIR"
    note "eixos lineares, no formato do KAT (HIST_ESCALA=log volta ao log10;"
    note "  HIST_XMAX / HIST_YMAX mandam nos limites na mao)"
    note "saem duas figuras (4 especies / 4 especies uniformizadas)"
    [ -n "$amostra" ] && note "sample: $amostra"
    [ -n "$grades" ]  && note "grades: $grades"

    # PADRAO: VAI PARA A FILA. O Python abre catalogos de dezenas de milhoes
    # de hashes e o R desenha figuras grandes - nenhum dos dois e servico de
    # no de login, onde alias o modulo do sourmash nem costuma estar
    # carregado. O --local existe para uma sessao interativa (qlogin).
    if [ -n "$so_plot" ]; then
        [ -s "$tsv" ] || kamces_die "--so-plot: $tsv nao existe ou esta vazio.
  Rode o hist sem --so-plot uma vez para gerar a tabela."
        note "--so-plot: reaproveitando a tabela ($(wc -l < "$tsv") linhas)"
    fi
    if [ -n "$local_" ]; then
        if [ -z "$so_plot" ]; then
            py_local sourmash
            note "--local: rodando aqui mesmo, sem passar pela fila"
            python3 "$HERE/stages/hist_kmers.py" --catalogs-dir "$CATALOGS_DIR" \
                --saida "$tsv" --ks "$KS" --scaled "$SCALEDS" \
                ${amostra:+--sample "$amostra"} || return 1
        fi
        note "tabela: $tsv"
        HIST_GRADES="$grades" Rscript --vanilla "$HERE/stages/hist_kmers.R" "$tsv" "$png"
        return $?
    fi
    note "saida: $hdir"
    note "tabela: $(basename "$tsv")"
    note "figuras: $(basename "${png%.png}")_{especies,uniformizado}[_parametros].png"
    local m="$MANIFEST_DIR/hist.tsv"
    printf '%s\t%s\t%s\n' "$CATALOGS_DIR" "$png" "$tsv" > "$m"
    local jid; jid=$(submit hist 1 "$m" \
        -v HIST_SAMPLE="$amostra",HIST_GRADES="$grades",HIST_SO_PLOT="$so_plot",HIST_ESCALA="${HIST_ESCALA:-}",HIST_XMAX="${HIST_XMAX:-}",HIST_YMAX="${HIST_YMAX:-}",HIST_ERRO_ATE="${HIST_ERRO_ATE:-}")
    jid_ok "$jid" "hist"
    note "job $jid (1 tarefa); log em $(logdir_for hist)"
}

