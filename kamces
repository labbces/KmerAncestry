# --------------------------------------------------- catalogs-ms --reparar --
# Varre a pasta de zips por acesso e conserta o que ficou para tras: zips que
# nunca apareceram, zips de 0 byte e temporarios ".{...}.parcial.zip" de
# corridas mortas.
#
# A ORDEM IMPORTA, e e o ponto todo deste comando:
#
#   FASE 1  garantir o SCALED MAIS FINO de todo acesso. So ele exige reler o
#           FASTQ - a parte cara, horas por acesso. Vai para a fila com
#           SCALEDS_FORCA, para nao baixar nada por causa dos grossos.
#   FASE 2  DERIVAR 100, 200 e 500 do 50, por downsample. Um sketch scaled=50
#           guarda os hashes < MAX/50; o pedaco dele abaixo de MAX/200 e,
#           exatamente, o scaled=200. Nao ha rede, nao ha FASTQ.
#
# A fase 2 espera a fase 1 por -hold_jid. Se nao houver pendencia nenhuma na
# fase 1, a fase 2 e submetida sozinha.
cmd_catalogs_ms_reparar() {
    local zips="${CATALOGS_MS_ZIPS:-$CATALOGS_DIR/zips_por_acesso}"
    local pend="$MANIFEST_DIR/reparo_pendentes.tsv"
    local pend_ac="$MANIFEST_DIR/reparo_pendentes.txt"
    local mm="$MANIFEST_DIR/reparo_especies.tsv"
    [ -d "$zips" ] || kamces_die "pasta de zips nao existe: $zips"

    local fino; fino=$(printf '%s\n' $SCALEDS | sort -n | head -1)
    local grossos; grossos=$(printf '%s\n' $SCALEDS | sort -n | tail -n +2 | tr '\n' ' ')

    # O QUE PRECISA EXISTIR POR ACESSO. Com a derivacao feita depois do merge,
    # so o scaled mais fino precisa estar em zip por acesso; os grossos saem
    # do catalogo fundido. Com MS_TODOS_SCALED=1 o antigo volta, e ai a fase 2
    # (downsample zip a zip) tem serventia de novo.
    local escalas="$fino"
    [ -n "${MS_TODOS_SCALED:-}" ] && escalas="$SCALEDS"
    say "reparo dos zips por acesso em $zips"
    if [ -n "${MS_TODOS_SCALED:-}" ]; then
        note "fase 1: garantir scaled=$fino (le FASTQ)   fase 2: derivar {${grossos% }}"
    else
        note "confere e refaz o scaled=$fino de cada acesso; os grossos {${grossos% }}"
        note "saem do catalogo fundido, no ./kamces catalogs-ms --so-merge"
    fi
    # A varredura roda AQUI, no no de login: e so stat() de arquivo, custa nada,
    # e o resultado precisa estar em maos para montar o array.
    python3 "$HERE/stages/reparar_zips.py" --zips-dir "$zips" \
        --species $SPECIES --ks $KS --scaled $escalas \
        --varrer --pendentes "$pend" || kamces_die "a varredura falhou"

    # `grep -c .` de arquivo vazio IMPRIME "0" e ainda devolve 1: com um
    # `|| echo 0` a variavel virava "0\n0" e o teste numerico estourava com
    # "integer expression expected". O wc -l sempre sai numero e sempre da 0.
    local n; n=$(wc -l < "$pend" 2>/dev/null || echo 0); n="${n//[^0-9]/}"; n="${n:-0}"
    cut -f2 "$pend" > "$pend_ac" 2>/dev/null || : > "$pend_ac"
    : > "$mm"; for sp in $SPECIES; do printf '%s\n' "$sp" >> "$mm"; done
    local nm; nm=$(wc -l < "$mm"); nm="${nm//[^0-9]/}"; nm="${nm:-0}"
    [ "$nm" -gt 0 ] || kamces_die "SPECIES esta vazio no config.sh"

    local espera=""
    if [ "$n" -gt 0 ]; then
        [ -n "${SRA_PASSWORD:-}" ] || kamces_die \
            "$n acesso(s) precisam voltar para o manysketch, e isso baixa FASTQ.
  Exporte SRA_PASSWORD antes (export SRA_PASSWORD='...')."
        local teto="${TETO_DISCO_GB:-1000}"
        local tc; tc=$(python3 "$HERE/stages/planejar_disco.py" \
            --teto-gb "$teto" --folga "${FOLGA_DISCO:-1.3}" \
            --pendentes "$pend_ac" --maximo "$MAX_JOBS" 2>/tmp/kamces_disco.$$ || echo 1)
        sed 's/^/   /' "/tmp/kamces_disco.$$" >&2 2>/dev/null || true
        rm -f "/tmp/kamces_disco.$$"
        case "$tc" in ''|*[!0-9]*) tc=1 ;; esac
        TC_ESTAGIO="$tc"
        note "fase 1: $n acesso(s) pendente(s), ate $tc ao mesmo tempo (teto ${teto} GB)"
        # SCALEDS_FORCA restringe o job ao scaled fino; MODO_REPARO faz ele
        # ignorar o .sig final da especie, que existe mas foi montado sem estes
        # acessos - sem isso a tarefa sairia dizendo "ja existe, nada a fazer".
        local jid1; jid1=$(submit catalogs_ms "$n" "$pend" \
            -v SRA_PASSWORD="$SRA_PASSWORD",MS_THREADS="${MS_THREADS:-}",TETO_DISCO_GB="$teto",SCALEDS_FORCA="$fino",MODO_REPARO=1,MS_TODOS_SCALED="${MS_TODOS_SCALED:-}" "$@")
        jid_ok "$jid1" "catalogs_ms (reparo)"
        note "fase 1: job $jid1"
        espera="$jid1"
        TC_ESTAGIO=""
    else
        note "fase 1: nenhum acesso pendente no scaled=$fino - nada a baixar"
    fi

    if [ -z "${grossos// /}" ] || [ -z "${MS_TODOS_SCALED:-}" ]; then
        # Sem MS_TODOS_SCALED nao ha fase 2: os scaled grossos nao existem
        # mais por acesso, saem do fundido.
        note "pronto. Quando a fase 1 terminar, junte e derive com:"
        note "  ./kamces catalogs-ms --so-merge --all --uniforme"
        return 0
    fi

    local ldr; ldr="$(logdir_for reparar_zips)"
    local snap=""
    [ -n "$espera" ] && snap="$(ultimo_snap)"
    if [ -z "$snap" ]; then
        snap="$(instantaneo reparar_zips "$mm")"; poda_instantaneos
        note "instantaneo: $snap"
    fi
    cp "$mm" "$snap/manifest_reparo.tsv"
    local jid2; jid2=$(qsub -terse -N kamces_reparar_zips -q "$QUEUE" \
        ${QSUB_L[@]+"${QSUB_L[@]}"} -o "$ldr" -e "$ldr" -t 1-"$nm" -tc "$MAX_JOBS" \
        ${espera:+-hold_jid "$espera"} \
        -v MANIFEST="$snap/manifest_reparo.tsv","$(env_do_snap "$snap")" \
        "$snap/stages/reparar_zips.job" | head -1 | cut -d. -f1)
    jid_ok "$jid2" "reparar_zips"
    note "fase 2: job $jid2 ($nm especie(s), espera ${espera:-nada})"
    note "depois que ele terminar, junte tudo com:"
    note "  ./kamces catalogs-ms --so-merge --all --uniforme"
}

# ------------------------------------------------------------- catalogs-ms --
# A via manysketch: um acesso por vez, baixa -> esboca -> apaga, e um sig merge
# no fim. Array por especie. O disco nunca segura mais de um par de FASTQ.
cmd_catalogs_ms() {
    python3 "$HERE/stages/checkflags.py" >/dev/null 2>&1 || {
        python3 "$HERE/stages/checkflags.py"
        kamces_die "corrija as flags acima antes de submeter"
    }
    # A senha e cobrada so por quem vai mesmo baixar FASTQ: --inventario,
    # --detalhe, --so-merge e um --reparar que nao achou pendencia nao tocam
    # na rede, e exigir a variavel ali so atrapalha.
    local so_merge="" inventario="" detalhe="" modo_all="" modo_uni="" reparar=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --so-merge)   so_merge=1; shift ;;
            --inventario) inventario=1; shift ;;
            --detalhe)    inventario=1; detalhe=1; shift ;;
            --all)        modo_all=1; shift ;;
            --uniforme)   modo_uni=1; shift ;;
            --reparar)    reparar=1; shift ;;
            *) break ;;
        esac
    done

    [ -n "$reparar" ] && { cmd_catalogs_ms_reparar "$@"; return $?; }
    if [ -z "$inventario" ] && [ -z "$so_merge" ]; then
        [ -n "${SRA_PASSWORD:-}" ] || kamces_die \
            "exporte SRA_PASSWORD antes (export SRA_PASSWORD='...')."
    fi

    # UMA TAREFA POR ACESSO, e nao por especie. Uma especie tem ate 26 acessos
    # lidos em fila; com 4 tarefas o cluster fica com 4 nucleos ocupados e a
    # especie leva dias. Uma linha por (especie, acesso) transforma isso em ~78
    # tarefas independentes, e o -tc decide quantas rodam juntas. Nada muda no
    # calculo: cada acesso ja gravava o seu proprio zip.
    # INVENTARIO: o estado exato de cada acesso, lendo o disco. E o que
    # responde "onde a corrida anterior parou" sem depender de nenhum log.
    local m="$MANIFEST_DIR/catalogs_ms.tsv"
    local mm="$MANIFEST_DIR/catalogs_ms_merge.tsv"
    local pend="$MANIFEST_DIR/catalogs_ms_pendentes.txt"
    : > "$m"; : > "$mm"; : > "$pend"
    local zips="${CATALOGS_MS_ZIPS:-$CATALOGS_DIR/zips_por_acesso}"
    # SO O SCALED MAIS FINO E BAIXADO. Os grossos saem por downsample depois
    # do merge, entao o inventario procura UM zip por (acesso, k), e nao um
    # por (acesso, k, scaled). MS_TODOS_SCALED=1 volta ao antigo.
    local fino; fino=$(printf '%s\n' $SCALEDS | sort -n | head -1)
    local escalas="$fino"
    [ -n "${MS_TODOS_SCALED:-}" ] && escalas="$SCALEDS"
    # ZIP PRONTO E ZIP QUE ABRE. Um manysketch interrompido deixa arquivo
    # truncado, que passa num `[ -s ]` e so estoura no sig merge. A pasta
    # inteira e conferida de uma vez, e o resultado vira um conjunto.
    local -A ZOK=()
    local _n
    while IFS= read -r _n; do [ -n "$_n" ] && ZOK["$_n"]=1; done < <(
        python3 "$HERE/stages/zips_ok.py" --dir "$zips" 2>/dev/null || true)
    local prontos=0 parciais=0 zerados=0 antigos=0
    for sp in $SPECIES; do
        printf '%s\n' "$sp" >> "$mm"
        local acs; acs=$(STAGES="$HERE/stages" python3 - "$sp" <<'PY'
import os, sys
sys.path.insert(0, os.environ["STAGES"])
from catalogs import samples_for_species
print(" ".join(samples_for_species(sys.argv[1], "skip")))
PY
)
        local a k sc tenho preciso falta_k
        for a in $acs; do
            tenho=0; preciso=0
            for k in $KS; do
                # este k ainda precisa de alguma saida?
                falta_k=""
                for sc in $SCALEDS; do
                    [ -s "$CATALOGS_DIR/${sp}_${k}_scaled${sc}.sig" ] && [ -z "${FORCAR:-}" ] && continue
                    falta_k=1
                done
                [ -n "$falta_k" ] || continue
                for sc in $escalas; do
                    preciso=$(( preciso + 1 ))
                    [ -n "${ZOK[${sp}_${a}_k${k}_scaled${sc}.zip]:-}" ] && tenho=$(( tenho + 1 ))
                done
            done
            # Zips no formato ANTIGO ({acesso}_scaled{N}.zip, sem o k no nome)
            # nao servem: eles carregam varios k juntos e o sig merge -k ficaria
            # ambiguo. Contamos so para avisar.
            ls "$zips/${sp}_${a}_scaled"*.zip >/dev/null 2>&1 && antigos=$(( antigos + 1 ))
            if [ "$preciso" -eq 0 ]; then prontos=$(( prontos + 1 ))
            elif [ "$tenho" -ge "$preciso" ]; then prontos=$(( prontos + 1 ))
            else
                [ "$tenho" -gt 0 ] && parciais=$(( parciais + 1 )) || zerados=$(( zerados + 1 ))
                printf '%s\t%s\n' "$sp" "$a" >> "$m"
                printf '%s\n' "$a" >> "$pend"
            fi
        done
    done
    local n nm; n=$(wc -l < "$m"); nm=$(wc -l < "$mm")

    # COMBINACAO ORFA: entrou no config DEPOIS que o esboço rodou, entao
    # nenhum acesso tem o zip dela. Como o FASTQ e apagado apos cada acesso,
    # incluir uma combinacao nova obriga a REBAIXAR todos os acessos. Sem este
    # aviso o sintoma e so "0 completo", que parece bug do inventario.
    # COMBINACAO ORFA: precisa de FASTQ que nao esta mais em disco. Com a
    # derivacao pos-merge, um scaled GROSSO novo nunca e orfao - ele sai do
    # zip fino. Orfao agora e um k novo, que exige reler os FASTQ.
    local orfas=0 orfas_txt=""
    for k in $KS; do
        local com_zip=0 sem_final=0
        for sp in $SPECIES; do
            for sc in $SCALEDS; do
                [ -s "$CATALOGS_DIR/${sp}_${k}_scaled${sc}.sig" ] || sem_final=1
            done
            ls "$zips"/*_k${k}_scaled${fino}.zip >/dev/null 2>&1 && com_zip=1
        done
        if [ "$sem_final" = 1 ] && [ "$com_zip" = 0 ]; then
            orfas=$(( orfas + 1 ))
            orfas_txt="${orfas_txt:+$orfas_txt, }k=$k"
        fi
    done

    note "acessos: $prontos completo(s), $parciais pela metade, $zerados sem nada"
    if [ "$orfas" -gt 0 ]; then
        note ""
        note "ATENCAO: $orfas valor(es) de k do config nao existem em NENHUM acesso:"
        note "  $orfas_txt"
        note "  Entraram no config depois que o esboço comecou. Como o FASTQ e"
        note "  apagado apos cada acesso, mante-los obriga a REBAIXAR os 78 acessos"
        note "  so para calcula-los - e por isso que aparece '0 completo'."
        note "  (Um scaled novo NAO da nisso: ele sai por downsample do scaled=$fino.)"
        note "  Se o k nao for essencial, tire-o do KS e re-rode este inventario."
    fi
    [ "$antigos" -gt 0 ] && note "AVISO: $antigos acesso(s) com zip no formato antigo (sem o k no nome) - serao refeitos"
    if [ -n "$detalhe" ]; then
        say "inventario detalhado (nada foi submetido)"
        note "CATALOGS_DIR     = $CATALOGS_DIR"
        note "zips por acesso  = $zips"
        note "config em uso    = $KAMCES_CONFIG"
        note "KS={$KS}  SCALEDS={$SCALEDS}"
        echo
        # `| head` fecha o cano e o basename morre de SIGPIPE; sob pipefail isso
        # derruba o resto do relatorio. Materializa a lista antes de cortar.
        local lista; lista="$(cd "$CATALOGS_DIR" 2>/dev/null && ls -1 *.sig 2>/dev/null || true)"
        local nsig; nsig=$(printf '%s' "$lista" | grep -c . || true)
        note "assinaturas finais ($nsig arquivo(s)):"
        printf '%s\n' "$lista" | sed -n '1,24p' | sed 's/^/     /'
        [ "${nsig:-0}" -gt 24 ] && note "   ... e mais $(( nsig - 24 ))"
        echo
        local lz; lz="$(cd "$zips" 2>/dev/null && ls -1 *.zip 2>/dev/null || true)"
        local nz; nz=$(printf '%s' "$lz" | grep -c . || true)
        note "zips por acesso ($nz arquivo(s)); 5 primeiros:"
        printf '%s\n' "$lz" | sed -n '1,5p' | sed 's/^/     /'
        echo
        # Tabela combinacao a combinacao para o PRIMEIRO acesso de cada especie
        for sp in $SPECIES; do
            local a1; a1=$(grep -m1 "^$sp	" "$m" 2>/dev/null | cut -f2)
            [ -n "$a1" ] || a1=$(STAGES="$HERE/stages" python3 -c "
import os,sys; sys.path.insert(0, os.environ['STAGES'])
from catalogs import samples_for_species
print(samples_for_species('$sp','skip')[0])" 2>/dev/null)
            [ -n "$a1" ] || continue
            note "$sp / $a1 - o que o inventario procura:"
            printf '     %-4s %-6s %-22s %s\n' k scaled "final .sig existe?" "zip scaled=$fino abre?"
            for k in $KS; do for sc in $SCALEDS; do
                local f z
                [ -s "$CATALOGS_DIR/${sp}_${k}_scaled${sc}.sig" ] && f="SIM" || f="nao"
                [ -n "${ZOK[${sp}_${a1}_k${k}_scaled${fino}.zip]:-}" ] && z="SIM" || z="nao"
                printf '     %-4s %-6s %-22s %s\n' "$k" "$sc" "$f" "$z"
            done; done
            echo
        done
        return 0
    fi
    if [ -n "$inventario" ]; then
        say "inventario (nada foi submetido)"
        note "faltam $n acesso(s); lista em $m"
        [ "$n" -gt 0 ] && sed 's/^/   /' "$m" | head -30
        [ "$n" -gt 30 ] && note "... e mais $(( n - 30 ))"
        return 0
    fi
    if [ "$n" -eq 0 ] && [ -z "$so_merge" ]; then
        note "nenhum acesso pendente - so o merge sera submetido"
        so_merge=1
    fi

    local nk nsc tem=0 falta=0
    nk=$(printf '%s\n' $KS | wc -l); nsc=$(printf '%s\n' $SCALEDS | wc -l)
    for sp in $SPECIES; do for k in $KS; do for sc in $SCALEDS; do
        if [ -s "$CATALOGS_DIR/${sp}_${k}_scaled${sc}.sig" ]; then
            tem=$(( tem + 1 )); else falta=$(( falta + 1 )); fi
    done; done; done

    # TETO DE DISCO. Cada tarefa segura UM par de FASTQ enquanto esboca, entao
    # o pico do estagio e a soma dos acessos baixando ao mesmo tempo - ou seja,
    # o -tc. O planejador olha os tamanhos reais (SraRunTable) e devolve o maior
    # -tc cujo PIOR CASO (as N maiores simultaneas) cabe no teto.
    local teto="${TETO_DISCO_GB:-1000}"
    local tc; tc=$(python3 "$HERE/stages/planejar_disco.py" \
        --teto-gb "$teto" --folga "${FOLGA_DISCO:-1.3}" \
        --pendentes "$pend" --maximo "$MAX_JOBS" 2>/tmp/kamces_disco.$$ || echo 1)
    sed 's/^/   /' "/tmp/kamces_disco.$$" >&2 2>/dev/null || true
    rm -f "/tmp/kamces_disco.$$"
    case "$tc" in ''|*[!0-9]*) tc=1 ;; esac
    TC_ESTAGIO="$tc"

    say "01 catalogos via manysketch: $nm especie(s), k={$KS}, scaled={$SCALEDS}"
    note "array com $n tarefa(s): 1 por ACESSO, ate $tc ao mesmo tempo (teto ${teto} GB)"
    note "assinaturas: $(( nm * nk * nsc )) no total, $tem em disco, $falta a gerar"
    note "por acesso: baixa os 2 mates -> manysketch no scaled=$fino -> apaga os FASTQ"
    note "os scaled grossos saem do fundido, por downsample (MS_TODOS_SCALED=1 desliga)"
    note "acesso ja esbocado e pulado sem baixar nada - da para re-submeter a vontade"
    note "zips por acesso: ${CATALOGS_MS_ZIPS:-$CATALOGS_DIR/zips_por_acesso}"
    note "pico de disco por tarefa: um par de FASTQ (APAGAR_ZIPS=1 limpa os zips no fim)"

    local espera=""
    if [ -z "$so_merge" ]; then
        JID_CAT_MS=$(submit catalogs_ms "$n" "$m" \
            -v SRA_PASSWORD="$SRA_PASSWORD",FORCAR="${FORCAR:-}",MS_THREADS="${MS_THREADS:-}",TETO_DISCO_GB="$teto",MS_TODOS_SCALED="${MS_TODOS_SCALED:-}" "$@")
        jid_ok "$JID_CAT_MS" "catalogs_ms"
        note "esboço: job $JID_CAT_MS  ($n tarefas)"
        espera="$JID_CAT_MS"
    else
        note "--so-merge: nada sera baixado, so o sig merge do que ja existe"
    fi

    # O merge espera o array inteiro e roda uma tarefa por especie. Reusa o
    # instantaneo do esboço quando ele existe, para os dois jobs rodarem
    # exatamente o mesmo codigo e o mesmo config.
    local ldm; ldm="$(logdir_for catalogs_ms_merge)"
    local snapm=""
    [ -z "$so_merge" ] && snapm="$(ultimo_snap)"
    if [ -z "$snapm" ]; then
        snapm="$(instantaneo catalogs_ms_merge "$mm")"; poda_instantaneos
        note "instantaneo: $snapm"
    fi
    cp "$mm" "$snapm/manifest_merge.tsv"

    # --uniforme: a lista de acessos de profundidade equivalente e calculada
    # AQUI e congelada no instantaneo, para o merge nao depender de recalcular.
    local selecao=""
    if [ -n "$modo_uni" ]; then
        selecao="$snapm/selecao_uniforme.tsv"
        python3 "$HERE/stages/uniformizar.py" --species "$SPECIES" \
            --referencia "${UNIFORME_REF:-spontaneum}" --saida "$selecao" \
            > "$MANIFEST_DIR/selecao_uniforme.txt" 2>&1 \
            || { sed 's/^/   /' "$MANIFEST_DIR/selecao_uniforme.txt" >&2
                 kamces_die "nao consegui montar a selecao uniforme"; }
        note "selecao uniforme: $(grep -c . "$selecao") acesso(s); relatorio em"
        note "  $MANIFEST_DIR/selecao_uniforme.txt"
    fi
    TC_ESTAGIO=""   # o merge nao usa disco de FASTQ: volta ao MAX_JOBS
    JID_CAT_MS_MERGE=$(qsub -terse -N kamces_cat_ms_merge -q "$QUEUE" \
        ${QSUB_L[@]+"${QSUB_L[@]}"} -o "$ldm" -e "$ldm" -t 1-"$nm" -tc "$MAX_JOBS" \
        ${espera:+-hold_jid "$espera"} \
        -v MANIFEST="$snapm/manifest_merge.tsv","$(env_do_snap "$snapm")",FORCAR="${FORCAR:-}",APAGAR_ZIPS="${APAGAR_ZIPS:-}",MODO_ALL="${modo_all:-}",MODO_UNI="${modo_uni:-}",SELECAO="${selecao:-}",MS_TODOS_SCALED="${MS_TODOS_SCALED:-}" \
        "$snapm/stages/catalogs_ms_merge.job" | head -1 | cut -d. -f1)
    jid_ok "$JID_CAT_MS_MERGE" "catalogs_ms_merge"
    note "merge : job $JID_CAT_MS_MERGE  ($nm tarefas, espera ${espera:-nada})"
}

